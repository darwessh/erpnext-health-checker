# ERPNext Health Checker — environment variables
#
# Copy this file to .env and fill in values for local development.
# Never commit your actual .env file.

# ── Flask ─────────────────────────────────────────────────────────────────────

# Set to "development" for auto-reload and debug error pages.
# Use "production" (or omit) when running behind gunicorn.
FLASK_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────────

# Comma-separated list of origins allowed to call /audit cross-origin.
# Leave empty (or unset) to disable CORS entirely — the browser UI on /
# does not need CORS because it is same-origin.
#
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
CORS_ORIGINS=
